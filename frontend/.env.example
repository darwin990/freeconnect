VITE_API_BASE_URL=http://localhost:8080/api/v1
# Intervalo de polling para notificaciones (ms). 0 desactiva el polling.
VITE_NOTIFICATIONS_POLL_MS=30000
# Intervalo de polling para mensajería (ms). 0 desactiva el polling.
VITE_MESSAGING_POLL_MS=5000
# Habilita /demo en builds de producción. En desarrollo siempre está activa.
VITE_ENABLE_DEMO=false
