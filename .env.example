# Copiar a .env y ajustar antes de docker compose up.
POSTGRES_DB=freeconnect
POSTGRES_USER=freeconnect
POSTGRES_PASSWORD=change-me

# Minimo 32 bytes; en produccion generar con openssl rand -base64 48
JWT_SECRET=change-me-freeconnect-secret-at-least-32-bytes

ADMIN_EMAIL=admin@freeconnect.io
ADMIN_PASSWORD=Admin#FreeConnect2026

# MOCK | LEGACY
PAYMENT_PROVIDER=MOCK

# URL publica usada para enlazar archivos de portafolio
S3_PUBLIC_URL=http://localhost:8080/assets

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
